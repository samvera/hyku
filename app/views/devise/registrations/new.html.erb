<div class="row justify-content-center">
  <div class="col-md-9 account-form registration">
    <h2><%= t(".sign_up_header") %></h2>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: '' }) do |f| %>
      <%= f.error_notification %>

      <div class="form-inputs">
        <%= render 'devise/shared/signup_fields', f: f %>
      </div>

      <div class="form-actions">
        <%= render 'devise/shared/links' %>
        <%= f.button :submit, t(".sign_up") %>
      </div>
    <% end %>
  </div>
</div>
