<div class="work-title-wrapper dc-show-head">
  <p class="dc-show-badge">
    <%= dc_badge(theme_type_label(presenter), class_name: 'dc-chip') %>
    <% if presenter.visibility != 'open' %><%= presenter.permission_badge %><% end %>
    <%= presenter.workflow.badge %>
  </p>

  <div class="dc-show-titleline">
    <% presenter.title.each do |title| %>
      <h1 class="dc-show-title"><%= markdown(title) %></h1>
    <% end %>
  </div>

  <% date = Array(presenter.date_created).first.presence || Array(presenter.try(:date_issued)).first %>
  <% byline = [all_authors(presenter).first, date].compact_blank %>
  <% if byline.any? %>
    <p class="dc-show-byline"><%= safe_join(byline, ' · ') %></p>
  <% end %>
</div>
