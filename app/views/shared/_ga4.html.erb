<%# OVERRIDE Hyrax 5.3.0 to send to the tenant's ID and the app wide GOOGLE_ANALYTICS_ID, read from current_account rather than the shared Hyrax::Analytics.config %>
<% measurement_ids = [current_account&.google_analytics_id.presence, ENV['GOOGLE_ANALYTICS_ID'].presence].compact.uniq %>
<% if measurement_ids.any? %>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= measurement_ids.first %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
<% measurement_ids.each do |measurement_id| %>
  gtag('config', '<%= measurement_id %>');
<% end %>
  window.analytics = gtag;
</script>
<meta name="analytics-provider" content="ga4">
<% end %>
