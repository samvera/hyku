<%# The terms of one vocabulary. `reorderable` adds the drag handles and the move
    buttons; the presenter answers whether the retire/restore button belongs, since a
    yaml vocabulary has no rows to change and renders read-only.

    controlled-vocabularies-scroll restores the scroll Hyrax disables on
    .table-responsive app-wide; see hyku.scss. A term id can be a full uri, so this
    table overflows readily. %>
<% entry = presenter.entry %>
<% terms = presenter.terms %>
<% togglable = presenter.togglable? %>
<div class="table-responsive controlled-vocabularies-scroll">
  <table class="table table-borderless controlled-vocabularies"
         <% if reorderable %>
           data-term-order-table
           <%# The order the server sent, so a page restored from the Turbolinks cache
               with rows already moved still compares against the saved order. %>
           data-term-order-loaded="<%= terms.map { |term| term['term_id'] }.join(',') %>"
           <%# The vocabulary's size, not the page's: a listing capped at TERM_LIMIT
               would otherwise announce "position 2 of 500" for a term that is second
               of thirty thousand. %>
           data-term-total="<%= entry.term_count || terms.size %>"
           data-moved-template="<%= t('hyku.admin.controlled_vocabulary.moved',
                                      label: '%{label}', position: '%{position}',
                                      total: '%{total}') %>"
           data-at-template="<%= t('hyku.admin.controlled_vocabulary.at_position',
                                   label: '%{label}', position: '%{position}',
                                   total: '%{total}') %>"
         <% end %>>
    <caption class="sr-only"><%= entry.label %></caption>
    <thead>
      <tr>
        <% if reorderable %>
          <th scope="col" class="controlled-vocabulary-order">
            <%= render 'column_hint',
                       label: t('hyku.admin.controlled_vocabulary.order'),
                       hint: t('hyku.admin.controlled_vocabulary.order_hint') %>
          </th>
        <% end %>
        <th scope="col">
          <%= render 'column_hint',
                     label: t('hyku.admin.controlled_vocabulary.label'),
                     hint: t('hyku.admin.controlled_vocabulary.label_hint') %>
        </th>
        <th scope="col">
          <%= render 'column_hint',
                     label: t('hyku.admin.controlled_vocabulary.term_id'),
                     hint: t('hyku.admin.controlled_vocabulary.term_id_hint') %>
        </th>
        <th scope="col"><%= t('hyku.admin.controlled_vocabulary.status') %></th>
        <% if togglable %>
          <th scope="col">
            <span class="sr-only"><%= t('hyku.admin.controlled_vocabulary.status_action') %></span>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% terms.each do |term| %>
        <tr class="border-bottom"
            <% if reorderable %>
              data-term-row
              data-term-id="<%= term['term_id'] %>"
              data-term-label="<%= term['label'] %>"
            <% end %>>
          <% if reorderable %>
            <td class="controlled-vocabulary-order">
              <%# The id, not a position: the browser submits these in document order,
                  so the order is carried by the sequence of the fields themselves and
                  no number on the page has to be kept in step with the rows. %>
              <%= hidden_field_tag 'term_ids[]', term['term_id'], id: nil %>

              <div class="term-order-controls">
                <button type="button" class="term-order-handle" data-term-handle
                        aria-label="<%= presenter.reorder_handle_label(term) %>">
                  <span aria-hidden="true">⠿</span>
                </button>
                <button type="button" class="term-order-move" data-term-move="-1"
                        aria-label="<%= presenter.move_label(term, -1) %>">
                  <span aria-hidden="true">&uarr;</span>
                </button>
                <button type="button" class="term-order-move" data-term-move="1"
                        aria-label="<%= presenter.move_label(term, 1) %>">
                  <span aria-hidden="true">&darr;</span>
                </button>
              </div>
            </td>
          <% end %>
          <td><%= term['label'] %></td>
          <td><code><%= term['id'] %></code></td>
          <td>
            <span class="badge <%= presenter.status_variant(term) %>">
              <%= presenter.status_label(term) %>
            </span>
          </td>
          <% if togglable %>
            <td class="controlled-vocabulary-status-action">
              <%# The button sits inside the reorder form but `form` reassigns its
                  owner, so it submits its own and no form has to nest in another;
                  see _term_status_forms. Outlined because it submits a change.

                  The reason is rendered hidden and revealed by the script, so it
                  joins the accessible name only while the button is unavailable. %>
              <button type="submit" form="term-status-<%= term['term_id'] %>"
                      data-term-status-toggle
                      class="btn btn-sm term-status-toggle <%= presenter.toggle_variant(term) %>"
                      name="active" value="<%= presenter.toggle_value(term) %>">
                <%= presenter.toggle_label(term) %>
                <span class="sr-only"><%= term['label'] %></span>
                <span class="sr-only d-none" data-term-status-reason>
                  <%= t('hyku.admin.controlled_vocabulary.order_unsaved_short') %>
                </span>
              </button>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
