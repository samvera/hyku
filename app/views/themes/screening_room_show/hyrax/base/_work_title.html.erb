<div class="work-title-wrapper scr-show-head">
  <p class="scr-show-eyebrow">
    <span class="scr-chip"><%= theme_type_label(presenter) %></span>
    <% collection = theme_show_collection(presenter) %>
    <% if collection %>
      <span class="scr-show-context">
        <%= link_to Array(collection.title).first.presence || collection.title_or_label,
                    hyrax.collection_path(collection.id) %>
      </span>
    <% end %>
  </p>

  <div class="scr-show-titleline">
    <% presenter.title.each do |title| %>
      <h1 class="scr-show-title"><%= markdown(title) %></h1>
    <% end %>
    <span class="scr-show-chips">
      <%= presenter.permission_badge %>
      <%= presenter.workflow.badge %>
    </span>
  </div>
</div>
