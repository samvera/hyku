<% provide :page_title, application_name %>

<%# Scholarly emphasis: an institutional repository leads with entry points
    and recency - browse by work type and subject first, recent uploads and
    the featured researcher next, showcase content after. The sections
    themselves come from the practice_research parent via view-path
    fall-through (see home_themes.yml parent:). %>
<div class="pr-home pr-home-scholarly">
  <%= render 'hyrax/homepage/browse' %>

  <% recent = @recent_documents.present? %>
  <% researcher = pr_featured_researcher? %>
  <% if recent || researcher %>
    <div class="pr-recent-row <%= 'pr-recent-row-single' unless recent && researcher %>">
      <%= render 'hyrax/homepage/recently_uploaded' %>
      <%= render 'hyrax/homepage/featured_researcher' %>
    </div>
  <% end %>

  <%= render 'hyrax/homepage/featured_works' %>
  <%= render 'hyrax/homepage/featured_collections' %>
  <%= render 'hyrax/homepage/about' %>
</div>

<%= render '/shared/select_work_type_modal', create_work_presenter: @presenter.create_work_presenter if @presenter.draw_select_work_modal? %>
