<%# Dynamic styles added by the admin in the appearances page %>
<% appearance = Hyku::Forms::Admin::Appearance.new %>
<style>
<% unless appearance.body_font.include?('Helvetica') %>
  @import url(//<%= appearance.font_import_body_url %>);
<% end %>
<% unless appearance.body_font.include?('Helvetica') %>
  @import url(//<%= appearance.font_import_headline_url %>);
<% end %>

body.public-facing { font-family: <%= appearance.font_body_family %> !important; }
body.public-facing h1,
body.public-facing h2,
body.public-facing h3,
body.public-facing h4,
body.public-facing h5,
body.public-facing h6 { font-family: <%= appearance.font_headline_family %> !important; }

/* LINK COLORS */
body.public-facing a,
body.public-facing .dropdown-menu a {
  color: <%= appearance.link_color %>;
}
body.public-facing a:hover,
body.public-facing a:focus { color: <%= appearance.link_hover_color %>; }

/* MAIN NAV */
body.public-facing .navbar.navbar-expand-lg,
body.public-facing footer.navbar {
  background-color: <%= appearance.header_and_footer_background_color %> !important;
}
body.public-facing footer.navbar .navbar-link { color: <%= appearance.footer_link_color %>; }
body.public-facing footer.navbar .navbar-link:hover { color: <%= appearance.footer_link_hover_color %>; }
body.public-facing footer.navbar .navbar-text,
body.public-facing .navbar-dark .navbar-nav .nav-link {
  color: <%= appearance.header_and_footer_text_color %> !important;
}
body.public-facing .navbar.navbar-expand-lg { border-color: <%= appearance.header_background_border_color %> !important; }

/* HOME PAGE SEARCH BAR NAV */
/* background row */
body.public-facing .image-masthead > .navbar.navbar-expand-sm {
  background-color: <%= appearance.navbar_background_color_alpha %> !important;
}
/* row button text */
body.public-facing .image-masthead .navbar.navbar-expand-sm li.nav-item a {
  color: <%= appearance.navbar_link_text_color %> !important;
}
/* row button color */
body.public-facing .image-masthead .nav.navbar-nav a {
  background-color: <%= appearance.navbar_link_background_color %>;
}
/* row active button */
body.public-facing .image-masthead .navbar .navbar-nav li.active a {
  background-color: <%= appearance.navbar_link_background_color_active %>;
}
/* row button hover text */
body.public-facing .image-masthead .navbar.navbar-expand-sm li.nav-item a:hover {
  color: <%= appearance.navbar_link_text_hover_color %> !important;
}
/* row button hover background color */
body.public-facing .image-masthead .nav.navbar-nav a:hover {
  background-color: <%= appearance.navbar_link_background_hover_color %>;
}
/* navbar other than main page uses default button text to match search button */
body.public-facing .nav.navbar-nav > li.nav-item > a.nav-link { color: <%= appearance.default_button_text_color %>; }

/* HOME PAGE NAV TABS */
body.public-facing .nav-tabs > li.nav-item > a:hover,
body.public-facing .nav-tabs > li.nav-item > a:focus {
    background-color: <%= appearance.active_tabs_background_color %> !important;
}

/* PRIMARY BUTTON STYLES */
body.public-facing .btn-primary,
body.public-facing .page-item.active > .page-link {
  background-color: <%= appearance.primary_button_background_color %> !important;
  border-color: <%= appearance.primary_button_border_color %> !important;
  color: <%= appearance.primary_button_text_color %> !important;
}
body.public-facing .btn-primary:focus,
body.public-facing .btn-primary.focus {
  background-color: <%= appearance.primary_button_focus_background_color %> !important;
  border-color: <%= appearance.primary_button_focus_border_color %> !important;
}
body.public-facing .btn-primary:hover {
  background-color: <%= appearance.primary_button_hover_background_color %> !important;
  border-color: <%= appearance.primary_button_hover_border_color %> !important;
}
body.public-facing .btn-primary:active,
body.public-facing .btn-primary.active {
  background-color: <%= appearance.primary_button_hover_color %> !important;
  border-color: <%= appearance.primary_button_border_color %> !important;
}
body.public-facing .btn-primary:active:hover,
body.public-facing .btn-primary:active:focus,
body.public-facing .btn-primary:active.focus,
body.public-facing .btn-primary.active:hover,
body.public-facing .btn-primary.active:focus,
body.public-facing .btn-primary.active.focus{
  background-color: <%= appearance.primary_button_hover_color %> !important;
  border-color: <%= appearance.primary_button_border_color %> !important;
}
body.public-facing .btn-primary.disabled:hover,
body.public-facing .btn-primary.disabled:focus,
body.public-facing .btn-primary.disabled.focus,
body.public-facing .btn-primary[disabled]:hover,
body.public-facing .btn-primary[disabled]:focus,
body.public-facing .btn-primary[disabled].focus {
  background-color: <%= appearance.primary_button_hover_color %> !important;
  border-color: <%= appearance.primary_button_border_color %> !important;
}

/* SECONDARY BUTTON STYLES (blacklight uses btn-light and btn-outline-secondary) */
body.public-facing .btn-secondary,
body.public-facing .btn-outline-secondary,
body.public-facing .btn-outline-secondary > .filter-name:after,
body.public-facing .sort-dropdown > .btn-outline-secondary,
body.public-facing .per_page-dropdown > .btn-outline-secondary,
body.public-facing .btn-light {
  background-color: <%= appearance.default_button_background_color %> !important;
  border-color: <%= appearance.default_button_border_color %> !important;
  color: <%= appearance.default_button_text_color %> !important;
}
body.public-facing .btn-secondary:focus,
body.public-facing .btn-secondary.focus,
body.public-facing .btn-outline-secondary:focus,
body.public-facing .btn-outline-secondary.focus,
body.public-facing .btn-light:focus,
body.public-facing .btn-light.focus {
  background-color: <%= appearance.default_button_focus_background_color %> !important;
  border-color: <%= appearance.default_button_focus_border_color %> !important;
}
body.public-facing .btn-secondary > dd.hover,
body.public-facing .btn-secondary > li.hover,
body.public-facing .btn-secondary > a.hover,
body.public-facing .btn-secondary:hover,
body.public-facing .btn-outline-secondary:hover,
body.public-facing .btn-light:hover {
  background-color: <%= appearance.default_button_hover_background_color %> !important;
  border-color: <%= appearance.default_button_hover_border_color %> !important;
  color: <%= appearance.default_button_text_color %> !important;
}
body.public-facing .btn-secondary:active,
body.public-facing .btn-secondary.active,
body.public-facing .btn-outline-secondary.view-type-list:active,
body.public-facing .btn-outline-secondary.view-type-gallery:active,
body.public-facing .btn-outline-secondary.view-type-masonry:active,
body.public-facing .btn-outline-secondary.view-type-slideshow:active,
body.public-facing .btn-outline-secondary.view-type-list.active,
body.public-facing .btn-outline-secondary.view-type-gallery.active,
body.public-facing .btn-outline-secondary.view-type-masonry.active,
body.public-facing .btn-outline-secondary.view-type-slideshow.active,
body.public-facing .btn-light:active,
body.public-facing .btn-light.active,
body.public-facing .btn-light.view-type-list:active,
body.public-facing .btn-light.view-type-gallery:active,
body.public-facing .btn-light.view-type-masonry:active,
body.public-facing .btn-light.view-type-slideshow:active,
body.public-facing .btn-light.view-type-list.active,
body.public-facing .btn-light.view-type-gallery.active,
body.public-facing .btn-light.view-type-masonry.active,
body.public-facing .btn-light.view-type-slideshow.active {
  background-color: <%= appearance.default_button_active_background_color %> !important;
  border-color: <%= appearance.default_button_active_border_color %> !important;
}
body.public-facing .btn-secondary:active:hover,
body.public-facing .btn-secondary:active:focus,
body.public-facing .btn-secondary:active.focus,
body.public-facing .btn-secondary.active:hover,
body.public-facing .btn-secondary.active:focus,
body.public-facing .btn-secondary.active.focus,
body.public-facing .btn-light:active:hover,
body.public-facing .btn-light:active:focus,
body.public-facing .btn-light:active.focus,
body.public-facing .btn-light.active:hover,
body.public-facing .btn-light.active:focus,
body.public-facing .btn-light.active.focus,
body.public-facing .btn-light.view-type-list:hover,
body.public-facing .btn-light.view-type-gallery:hover,
body.public-facing .btn-light.view-type-masonry:hover,
body.public-facing .btn-light.view-type-slideshow:hover {
  background-color: <%= appearance.default_button_focus_background_color %> !important;
  border-color: <%= appearance.default_button_focus_border_color %> !important;
  color: <%= appearance.default_button_text_color %> !important;
}
body.public-facing .btn-secondary.disabled:hover,
body.public-facing .btn-secondary.disabled:focus,
body.public-facing .btn-secondary.disabled.focus,
body.public-facing .btn-secondary[disabled]:hover,
body.public-facing .btn-secondary[disabled]:focus,
body.public-facing .btn-secondary[disabled].focus,
body.public-facing .btn-light.disabled:hover,
body.public-facing .btn-light.disabled:focus,
body.public-facing .btn-light.disabled.focus,
body.public-facing .btn-light[disabled]:hover,
body.public-facing .btn-light[disabled]:focus,
body.public-facing .btn-light[disabled].focus {
  background-color: <%= appearance.default_button_background_color %> !important;
  border-color: <%= appearance.default_button_border_color %> !important;
}

/* FACET PANEL STYLES */
body.public-facing .card > .card-header,
body.public-facing .card-header > .btn.w-100 {
  color: <%= appearance.facet_panel_text_color %>;
  background-color: <%= appearance.facet_panel_background_color %> !important;
}
body.public-facing .card {
  border-color: <%= appearance.facet_panel_border_color  %> !important;
}
body.public-facing .card-body > .facet-limit-active {
  color: <%= appearance.facet_panel_text_color %> !important;
  background-color: <%= appearance.facet_panel_background_color %>;
}

/* COLLECTION STYLES */
body.public-facing .hyc-banner .hyc-title h1 {
  color: <%= appearance.collection_banner_text_color %> !important;
}

/* PRACTICE RESEARCH THEME CUSTOMIZATIONS */
<% if home_page_theme == 'practice_research' || show_page_theme == 'practice_research_show' %>
:root {
  --pr-accent: <%= appearance.primary_button_background_color %>;
  --pr-accent-ink: <%= appearance.primary_button_text_color %>;
  --pr-band-dark: <%= appearance.header_and_footer_background_color %>;
  --pr-band-text: <%= appearance.header_and_footer_text_color %>;
  --pr-band-link: <%= appearance.footer_link_color %>;
  --pr-link: <%= appearance.link_color %>;
  --pr-primary: <%= appearance.link_color %>;
  --pr-brand-ink: <%= appearance.link_hover_color %>;
  --pr-button: <%= appearance.default_button_background_color %>;
  --pr-button-edge: <%= appearance.default_button_border_color %>;
  --pr-button-ink: <%= appearance.default_button_text_color %>;
  --pr-button-hover: <%= appearance.default_button_hover_background_color %>;
  --pr-button-hover-edge: <%= appearance.default_button_hover_border_color %>;
}
<% end %>

/* HERITAGE THEME CUSTOMIZATIONS */
<% if home_page_theme == 'heritage' || show_page_theme == 'heritage_show' %>
  <% heritage_default_serif = appearance.headline_font.include?('Helvetica') %>
  <% heritage_default_sans = appearance.body_font.include?('Helvetica') %>
:root {
  --hrt-serif: <%= heritage_default_serif ? 'Georgia, Times New Roman, serif' : appearance.font_headline_family %>;
  --hrt-sans: <%= heritage_default_sans ? 'Helvetica Neue, Helvetica, Arial, sans-serif' : appearance.font_body_family %>;
  --hrt-chrome: <%= appearance.header_and_footer_background_color %>;
  --hrt-paper: #fffdf8;
  --hrt-sunken: color-mix(in srgb, var(--hrt-chrome) 8%, var(--hrt-paper));
  --hrt-cta: color-mix(in srgb, var(--hrt-link-strong) 14%, #ffffff);
  --hrt-cta-edge: color-mix(in srgb, var(--hrt-link-strong) 26%, #ffffff);
  --hrt-mat: var(--hrt-sunken);
  --hrt-mat-edge: color-mix(in srgb, var(--hrt-chrome) 16%, var(--hrt-paper));
  --hrt-mat-edge-hover: color-mix(in srgb, var(--hrt-chrome) 29%, var(--hrt-paper));
  --hrt-link: <%= appearance.link_color %>;
  --hrt-link-strong: <%= appearance.link_hover_color %>;
  --hrt-action: <%= appearance.primary_button_background_color %>;
  --hrt-action-ink: <%= appearance.primary_button_text_color %>;
  --hrt-button: <%= appearance.default_button_background_color %>;
  --hrt-button-edge: <%= appearance.default_button_border_color %>;
  --hrt-button-ink: <%= appearance.default_button_text_color %>;
  --hrt-button-hover: <%= appearance.default_button_hover_background_color %>;
  --hrt-button-hover-edge: <%= appearance.default_button_hover_border_color %>;
  --hrt-footer-accent: <%= appearance.footer_link_color %>;
}
<% end %>

/* SCREENING ROOM THEME CUSTOMIZATIONS */
<% if home_page_theme == 'screening_room' || show_page_theme == 'screening_room_show' %>
  <% screening_default_serif = appearance.headline_font.include?('Helvetica') %>
  <% screening_default_sans = appearance.body_font.include?('Helvetica') %>
:root {
  --scr-serif: <%= screening_default_serif ? 'Georgia, Times New Roman, serif' : appearance.font_headline_family %>;
  --scr-sans: <%= screening_default_sans ? 'Helvetica Neue, Helvetica, Arial, sans-serif' : appearance.font_body_family %>;
  --scr-chrome-pick: <%= theme_luminance(appearance.header_and_footer_background_color).between?(0.02, 0.0631) ? appearance.header_and_footer_background_color : '#3c3c3c' %>;
  --scr-chrome-deep: color-mix(in srgb, var(--scr-chrome-pick) 13%, #000000);
  --scr-chrome: color-mix(in srgb, var(--scr-chrome-pick) 25%, #000000);
  --scr-chrome-soft: color-mix(in srgb, var(--scr-chrome-pick) 37%, #000000);
  --scr-base: color-mix(in srgb, var(--scr-chrome-pick) 33%, #000000);
  --scr-raised: color-mix(in srgb, var(--scr-chrome-pick) 48%, #000000);
  --scr-band: color-mix(in srgb, var(--scr-chrome-pick) 43%, #000000);
  --scr-rule: color-mix(in srgb, var(--scr-chrome-pick) 63%, #000000);
  --scr-rule-input: color-mix(in srgb, var(--scr-chrome-pick) 78%, #000000);
  --scr-rule-strong: color-mix(in srgb, var(--scr-chrome-pick) 65%, #ffffff);
  --scr-rule-card: color-mix(in srgb, var(--scr-chrome-pick) 79%, #ffffff);
  --scr-accent: <%= appearance.link_color %>;
  --scr-accent-ink: <%= theme_readable_ink(appearance.link_color) %>;
  --scr-accent-hover: color-mix(in srgb, var(--scr-accent) 80%, <%= theme_readable_ink(appearance.link_color) == '#ffffff' ? '#000000' : '#ffffff' %>);
  --scr-link: color-mix(in srgb, var(--scr-accent) <%= theme_brand_mix(appearance.link_color) %>%, #ffffff);
  --scr-cta: color-mix(in srgb, var(--scr-accent) 27%, var(--scr-chrome));
  --scr-notice: color-mix(in srgb, #ffebcd 14%, var(--scr-chrome));
  --scr-notice-rule: color-mix(in srgb, #ffebcd 26%, var(--scr-chrome));
  --scr-footer-accent: <%= theme_luminance(appearance.footer_link_color) > 0.19 ? appearance.footer_link_color : "color-mix(in srgb, #{appearance.footer_link_color} #{theme_brand_mix(appearance.footer_link_color)}%, #ffffff)" %>;
}
<% end %>

/* REFERENCE THEME CUSTOMIZATIONS */
<% if home_page_theme == 'reference' || show_page_theme == 'reference_show' %>
  <% reference_hero_ground = theme_ground_for(appearance.header_and_footer_background_color, 88, '#2b2b2b') %>
  <% reference_default_serif = appearance.headline_font.include?('Helvetica') %>
  <% reference_default_sans = appearance.body_font.include?('Helvetica') %>
:root {
  --ref-serif: <%= reference_default_serif ? 'Newsreader, Georgia, Times New Roman, serif' : appearance.font_headline_family %>;
  --ref-sans: <%= reference_default_sans ? 'Public Sans, -apple-system, Segoe UI, Helvetica, Arial, sans-serif' : appearance.font_body_family %>;
  --ref-hero-ground: <%= reference_hero_ground %>;
  --ref-on-dark: color-mix(in srgb, <%= appearance.primary_button_background_color %> <%= theme_brand_mix_on(appearance.primary_button_background_color, reference_hero_ground) %>%, #ffffff);
  --ref-link: <%= appearance.link_color %>;
  --ref-link-strong: <%= appearance.link_hover_color %>;
  --ref-action: <%= appearance.primary_button_background_color %>;
  --ref-action-ink: <%= appearance.primary_button_text_color %>;
  --ref-button: <%= appearance.default_button_background_color %>;
  --ref-button-edge: <%= appearance.default_button_border_color %>;
  --ref-button-ink: <%= appearance.default_button_text_color %>;
  --ref-footer-accent: <%= appearance.footer_link_color %>;
}
<% end %>

<%= appearance.custom_css_block %>

/* COMMUNITY THEME CUSTOMIZATIONS */
body.community .community-explore-collections:hover {
  background-color: <%= appearance.primary_button_hover_color %>;
}
body.community .community-explore-collections:hover .card-title a {
  color: <%= appearance.primary_button_text_color %>;
}

</style>
