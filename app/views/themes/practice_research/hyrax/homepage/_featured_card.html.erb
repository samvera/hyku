<% document = presenter.solr_document %>
<% credit = pr_contributor_summary(document) %>

<%= link_to [main_app, presenter], class: 'pr-work-thumb',
            data: { turbolinks: block_valkyrie_redirect? }, tabindex: -1,
            aria: { hidden: true } do %>
  <%= render_thumbnail_tag(presenter, { alt: '' }, { suppress_link: true }) if pr_thumbnail?(presenter) %>
<% end %>

<div class="pr-work-body">
  <p class="pr-eyebrow">
    <span class="pr-eyebrow-type"><%= work_type_facet_label(Array(document['has_model_ssim']).first) %></span>
  </p>

  <h3 class="pr-portfolio-heading">
    <%= link_to Array(presenter.title).first.presence || document.title_or_label,
                [main_app, presenter],
                class: 'pr-portfolio-title',
                data: { turbolinks: block_valkyrie_redirect? } %>
  </h3>

  <% blurb = pr_card_blurb(presenter) %>
  <% if blurb %>
    <p class="pr-portfolio-blurb"><%= blurb %></p>
  <% end %>

  <% if credit %>
    <p class="pr-portfolio-credit"><%= credit %></p>
  <% end %>
</div>
