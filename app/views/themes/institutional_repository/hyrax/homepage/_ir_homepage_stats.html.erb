<% tiles = ir_resource_type_tiles(@ir_counts, @ir_counts_field) %>
<% if tiles.any? %>
  <div class='stats-color-block container-fluid pt-3 pb-3 mb-4'>
    <div class="row">
      <div class="col-md-12">
        <% if tiles.size <= 6 %>
          <%= render partial: 'resource_type_stats', locals: { tiles: } %>
        <% else %>
          <%= render partial: 'resource_type_slider', locals: { tiles: } %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
