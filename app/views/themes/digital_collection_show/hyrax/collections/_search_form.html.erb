<%# OVERRIDE Hyrax 5.3.0: "Search this collection" with a "Search" button and no icon, as a search landmark %>
<%= form_tag url, method: :get, class: 'dc-collection-search-form', role: 'search', 'aria-label': t('hyrax.collections.search_form.label', title: presenter.to_s) do %>
  <label for="collection_search" class="sr-only"><%= t('hyrax.collections.search_form.label', title: presenter.to_s) %></label>
  <div class="input-group">
    <%= search_field_tag :cq, params[:cq], class: 'form-control', id: 'collection_search', placeholder: t('digital_collection.collection.search_placeholder') %>
    <div class="input-group-append">
      <button type="submit" class="btn btn-primary" id="collection_submit"><%= t('digital_collection.search.submit') %></button>
    </div>
  </div>
  <%= hidden_field_tag :sort, params[:sort], id: 'collection_sort' %>
  <%= render Blacklight::HiddenSearchStateComponent.new(params: search_state.params_for_search.except(:cq, :sort, :qt, :page)) %>
<% end %>
