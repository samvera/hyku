<% content_for(:extra_body_classes, 'works-show ') %>
<% provide :page_title, @presenter.page_title %>

<% content_for :canonical_url do %>
  <link rel="canonical" href="<%= canonical_url_for(@presenter) %>" />
<% end %>

<%= render 'shared/citations' %>
<%= render 'shared/additional_citations' %>

<% panes = ref_show_panes(@presenter) %>
<% active_pane = theme_active_pane(panes) %>

<div class="ref-show" itemscope itemtype="http://schema.org/CreativeWork">
  <div class="ref-show-actions"><%= render 'show_actions', presenter: @presenter %></div>

  <div class="ref-record">
    <div class="ref-record-inner">
      <%= render 'work_title', presenter: @presenter %>
    </div>
  </div>

  <%= render 'workflow_actions_widget', presenter: @presenter %>

  <% if theme_viewer?(@presenter) %>
    <div class="ref-viewer">
      <% if @presenter.video_embed_viewer? %>
        <%= render 'video_embed_viewer', presenter: @presenter %>
      <% elsif @presenter.iiif_viewer? %>
        <%= render 'representative_media', presenter: @presenter, viewer: true %>
      <% elsif @presenter.show_pdf_viewer? %>
        <%= render 'pdf_js', file_set_presenter: pdf_file_set_presenter(@presenter) %>
      <% else %>
        <div class="ref-viewer-still">
          <%= render 'representative_media', presenter: @presenter, viewer: false %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @presenter.description.present? %>
    <div class="ref-show-description">
      <%= render 'work_description', presenter: @presenter %>
    </div>
  <% end %>

  <div class="ref-show-body">
    <div class="ref-show-main">
      <ul class="nav nav-tabs ref-tabs" role="tablist" aria-label="<%= t('reference.show.tabs_label') %>">
        <% panes.each do |key, label, count| %>
          <li class="nav-item" role="presentation">
            <a class="nav-link <%= 'active' if key == active_pane %>"
               id="ref-tab-<%= key %>"
               href="?<%= request.query_parameters.merge(pane: key).to_query %>#ref-pane-<%= key %>"
               data-toggle="tab"
               data-target="#ref-pane-<%= key %>"
               role="tab"
               aria-controls="ref-pane-<%= key %>"
               aria-selected="<%= key == active_pane %>"><%= label %><% if count %><span class="ref-tab-count"><%= number_with_delimiter(count) %></span><% end %></a>
          </li>
        <% end %>
      </ul>

      <div class="tab-content ref-panes">
        <% panes.each do |key, label, _count| %>
          <div class="tab-pane <%= 'active show' if key == active_pane %>"
               id="ref-pane-<%= key %>"
               role="tabpanel"
               tabindex="0"
               aria-labelledby="ref-tab-<%= key %>">
            <h2 class="ref-pane-heading"><%= label %></h2>
            <% case key %>
            <% when :metadata %>
              <%= render 'featured_attributes', presenter: @presenter %>
              <%= render 'metadata', presenter: @presenter %>
              <%= render_compound_cards(@presenter) %>
            <% when :files %>
              <%= render 'files_pane', presenter: @presenter %>
            <% when :children %>
              <%= render 'children_pane', presenter: @presenter %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <aside class="ref-show-rail">
      <%= render 'citations', presenter: @presenter %>
      <%= render 'part_of_panel', presenter: @presenter %>
    </aside>
  </div>

  <span class='hide analytics-event' data-category="work" data-action="work-view" data-name="<%= @presenter.id %>"></span>
  <% @presenter.member_of_collection_ids.each do |collection_id| %>
    <span class='hide analytics-event' data-category="work-in-collection" data-action="work-in-collection-view" data-name="<%= collection_id %>"></span>
  <% end %>
</div>
