<% thumbnail = theme_thumbnail_url(document, default: :collection) %>
<% path = hyrax.collection_path(document.id) %>
<% placeholder = dc_thumb_placeholder_class(document) %>

<article class="dc-collection">
  <div class="<%= token_list('dc-collection-plate', placeholder) %>">
    <% unless placeholder %>
      <%= image_tag thumbnail, alt: '', class: 'dc-collection-plate-blur', aria: { hidden: true }, loading: 'lazy' %>
      <span class="dc-collection-plate-scrim"></span>
    <% end %>
    <%= link_to path, class: 'dc-collection-plate-figure', tabindex: -1, aria: { hidden: true } do %>
      <%= image_tag thumbnail, alt: '', loading: 'lazy' %>
    <% end %>
  </div>

  <div class="dc-collection-body">
    <h3 class="dc-collection-title">
      <%= link_to Array(document.title).first.presence || document.title_or_label, path %>
    </h3>

    <p class="dc-collection-description"><%= theme_blurb(dc_summary(document).first, length: 320) %></p>

    <p class="dc-collection-count">
      <%= dc_works_count(dc_home.browse_works_count(document)) %>
    </p>
  </div>
</article>
