<%# OVERRIDE Hyrax 5.3.0: headed section; reorder form for editors, a prompt to feature works for editors when none are, featured rows for visitors %>
<% featured = dc_home.featured_works %>
<% manager = can?(:update, FeaturedWork) %>
<% editable = manager && !@featured_work_list.empty? %>

<% if @presenter&.display_featured_works? && (featured.any? || manager) %>
  <section class="dc-featured" aria-labelledby="dc-featured-heading">
    <%= dc_section_head t('digital_collection.homepage.featured.heading'), id: 'dc-featured-heading' %>

    <% if editable %>
      <%= render 'hyrax/homepage/dc_reorder_form',
                 record: [hyrax, @featured_work_list], association: :featured_works,
                 row_partial: 'hyrax/homepage/sortable_featured', nestable_id: 'dd',
                 confirm: t('digital_collection.homepage.featured.unfeature_confirm'),
                 hint: t('digital_collection.homepage.featured.reorder_hint'),
                 save: t('digital_collection.homepage.featured.save_order') %>
    <% elsif featured.none? %>
      <p class="dc-empty"><%= t('digital_collection.homepage.featured.empty_admin', limit: FeaturedWork.feature_limit) %></p>
    <% else %>
      <ul class="dc-featured-list list-unstyled">
        <% featured.each do |work| %>
          <li><%= render 'hyrax/homepage/featured_fields', featured: work.presenter %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
