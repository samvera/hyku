<div class="pr-stack">
  <div class="pr-stack-layer pr-stack-layer-2" aria-hidden="true"></div>
  <div class="pr-stack-layer pr-stack-layer-1" aria-hidden="true"></div>
  <%= link_to [hyrax, presenter], class: 'pr-portfolio-cover', tabindex: -1,
              aria: { hidden: true } do %>
    <%= render_thumbnail_tag(presenter, { alt: '' }, { suppress_link: true }) if pr_thumbnail?(presenter) %>
  <% end %>
</div>

<div class="pr-portfolio-body">
  <p class="pr-eyebrow">
    <span class="pr-eyebrow-type"><%= presenter.human_readable_type %></span>
    <% work_count = pr_home.collection_works_count(presenter.solr_document) %>
    <% if work_count.positive? %>
      <span class="pr-eyebrow-sep" aria-hidden="true"></span>
      <span class="pr-eyebrow-count">
        <%= t('practice_research.homepage.featured.works_in_collection', count: work_count) %>
      </span>
    <% end %>
  </p>

  <h3 class="pr-portfolio-heading">
    <%= link_to Array(presenter.title).first.presence || presenter.solr_document.title_or_label,
                [hyrax, presenter],
                class: 'pr-portfolio-title' %>
  </h3>

  <% blurb = pr_card_blurb(presenter) %>
  <% if blurb %>
    <p class="pr-portfolio-blurb"><%= blurb %></p>
  <% end %>
</div>
