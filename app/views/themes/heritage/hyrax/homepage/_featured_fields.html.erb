<% document = featured.solr_document %>

<div class="hrt-tile">
  <%= link_to [main_app, featured], class: 'hrt-mat hrt-mat-tile', tabindex: -1, aria: { hidden: true } do %>
    <%= render_thumbnail_tag(featured, { alt: '' }, { suppress_link: true }) %>
  <% end %>

  <h3 class="hrt-tile-title">
    <%= link_to document.title_or_label, [main_app, featured] %>
  </h3>

  <p class="hrt-tile-byline"><%= safe_join([Array(featured.creator).first, hrt_date_created(document)].compact_blank, ' · ') %></p>

  <% collection = Hyrax::CollectionMemberService.run(document, current_ability).first %>
  <% if collection %>
    <p class="hrt-tile-collection">
      <%= link_to Array(collection.title).first, hyrax.collection_path(collection.id) %>
    </p>
  <% end %>
</div>
