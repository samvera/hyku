<section class="dc-recent" aria-labelledby="dc-recent-heading">
  <%= dc_section_head t('digital_collection.homepage.recent.heading'), id: 'dc-recent-heading',
                      action: link_to(t('digital_collection.homepage.recent.view_all'), main_app.search_catalog_path,
                                      class: 'dc-section-action') %>

  <ul class="dc-recent-grid list-unstyled">
    <% @recent_documents.each do |document| %>
      <li><%= render 'hyrax/homepage/recent_document', recent_document: document %></li>
    <% end %>
  </ul>
</section>
