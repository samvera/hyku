<%# OVERRIDE Hyrax 5.3.0: a "Description" section of ruled rows, one column, following the flexible metadata profile's labels and visibility and leaving out the title, dates and depositor shown elsewhere on the page; links to other sites open in a new tab %>
<% compound_schema = compound_schema_for(@presenter) %>
<% rows = if @presenter.try(:flexible?)
            view_options_for(@presenter).filter_map do |field, options|
              next if %i[title date_modified date_uploaded depositor].include?(field.to_sym) || compound_card_field?(@presenter, field)

              render_field = conform_field(field, options)
              view_options = conform_options(field, options.deep_dup.with_indifferent_access)
              next unless field_visible?(view_options, @presenter)
              next unless @presenter.respond_to?(render_field) && Array(@presenter.public_send(render_field)).compact_blank.present?

              @presenter.attribute_to_html(render_field, view_options.merge(html_dl: true))
            end
          else
            plain = %i[description creator license subject keyword date_created related_url resource_type alt_text].filter_map do |field|
              values = Array(@presenter.try(field)).compact_blank
              next if values.empty?

              safe_join([tag.dt(t("blacklight.search.fields.show.#{field}_tesim", default: field.to_s.humanize)),
                         tag.dd(auto_link(values.join(', ')))])
            end
            plain + compound_schema.inline_compound_names.filter_map do |field|
              next if Array(@presenter.try(field)).compact_blank.empty?

              @presenter.attribute_to_html(field.to_sym, render_as: :compound, html_dl: true)
            end
          end %>
<% rows += %i[embargo_release_date lease_expiration_date].filter_map do |field|
     value = @presenter.try(field)
     safe_join([tag.dt(t("blacklight.search.fields.show.#{field}_dtsi", default: field.to_s.humanize)), tag.dd(value)]) if value.present?
   end %>
<% if rows.any? %>
  <section class="dc-file-section" aria-labelledby="dc-file-description-label" <%= @presenter.microdata_type_to_html %>>
    <%= dc_section_head t('digital_collection.file_set.description'), id: 'dc-file-description-label' %>
    <% html = capture do %>
      <dl class="dc-meta-rows">
        <% rows.each do |row| %>
          <div><%= row %></div>
        <% end %>
      </dl>
    <% end %>
    <%= dc_external_links_in_new_tab(html) %>
  </section>
<% end %>
