<section class="scr-panel scr-cite" aria-labelledby="scr-cite-label">
  <div class="scr-panel-head">
    <h2 class="scr-panel-label" id="scr-cite-label"><%= t('hyrax.base.citations.header') %></h2>
  </div>

  <% citations = all_authors(presenter).any? ? theme_citations(presenter) : {} %>
  <% if citations.any? %>
    <div data-citation>
      <select class="scr-cite-picker" data-citation-picker
              aria-label="<%= t('hyrax.base.citations.style') %>">
        <% citations.each_key do |style| %>
          <option value="<%= style %>"><%= t("hyrax.citations.work.#{style}") %></option>
        <% end %>
      </select>

      <% citations.each_with_index do |(style, text), index| %>
        <blockquote class="scr-cite-text" data-citation-text="<%= style %>"
                    <%= 'hidden' unless index.zero? %>><%= text %></blockquote>
      <% end %>

      <div class="scr-cite-actions">
        <button type="button" class="scr-cite-copy" data-citation-copy>
          <%= t('hyrax.base.citations.copy') %>
        </button>
        <span class="scr-cite-copied" data-citation-copied hidden aria-live="polite">
          <%= t('hyrax.base.citations.copied') %>
        </span>
      </div>
    </div>
  <% end %>

  <p class="scr-cite-note"><%= t('hyrax.base.citations.note') %></p>

  <%= link_to t('hyrax.base.citations.endnote'),
              polymorphic_path([main_app, presenter], format: 'endnote'),
              class: 'scr-cite-export' %>
</section>
