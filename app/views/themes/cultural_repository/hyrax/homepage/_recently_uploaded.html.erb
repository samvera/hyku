<%# OVERRIDE Hyrax v5.0.0rc2 for theming %>

<h2 class="sr-only"><%= t('hyrax.homepage.recently_uploaded.title') %></h2>
<% if recent_documents.blank? %>
  <%# Absolute key: this partial is rendered by its explicit path from
      _recent_works_section, so lazy lookup resolves under themes.* where no keys exist %>
  <p><%= t('hyrax.homepage.recently_uploaded.no_public') %></p>
<% else %>
  <div id="recent_docs">
    <ol class="row list-group list-group-flush recent_uploads">
      <%= render partial: "themes/cultural_repository/hyrax/homepage/recent_document", collection: recent_documents %>
    </ol>
  </div>
<% end %>
