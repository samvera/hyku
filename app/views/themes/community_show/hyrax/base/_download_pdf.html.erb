<%#
  OVERRIDE: Hyku 7.0.0 to center the download PDF button with constrained width to match,
  rather than having it span the full page width as in the base Hyku implementation.

  Changes made for Community show theme styling:
  - Removed `btn-block` class to prevent full-width button spanning the page
  - Removed `center-block` class (Bootstrap 3, deprecated)
  - Added `mx-auto` and `d-block` classes (Bootstrap 4/5 utilities) for centered, non-full-width button
  - Added `text-center` class to wrapper div for container-level centering
  - Custom CSS in community_show_buttons.scss applies min-width: 350px, max-width: 500px for proper sizing
%>

<% pdf = pdf_file_set_presenter(presenter, downloadable: true) %>
<% if pdf.present? %>
  <div class="download-pdf-controls text-center">
    <%= link_to t('hyrax.base.download_pdf'),
                hyrax.download_path(pdf),
                id: 'file_download',
                class: 'btn btn-primary file_download mx-auto d-block',
                target: '_blank',
                rel: 'noopener noreferrer',
                role: 'button',
                data: { label: pdf.id } %>
  </div>
<% end %>
