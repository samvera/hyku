<%# OVERRIDE Hyku 7.1.0: a fixed set of fields per row (Creator, Date, Part of, Resource type and Description; Description and Works for collections) instead of every index field, each labeled and linked as the flexible metadata profile says, with links to other sites opening in a new tab %>
<div class="metadata dc-result-fields">
  <% rows = capture do %>
    <dl>
      <% dc_result_fields(document).each do |key, row| %>
        <div class="dc-result-field dc-result-field-<%= key.to_s.dasherize %>"><%= row %></div>
      <% end %>
    </dl>
  <% end %>
  <%= dc_external_links_in_new_tab(rows) %>
  <% if current_account.search_only && document.account_institution_name.first.present? %>
    <small class="search-only-institution-link">
      <span><%= t('digital_collection.search.results.from') %> <%= link_to document.account_institution_name&.join, "//#{document.account_cname.first}", target: :_blank %></span>
    </small>
  <% end %>
</div>
