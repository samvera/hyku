<% ids = presenter.list_of_item_ids_to_display %>
<% members = presenter.member_presenters(ids) %>

<section class="dc-panel" id="dc-items" aria-labelledby="dc-items-label">
  <div class="dc-panel-head">
    <h2 class="dc-panel-label" id="dc-items-label">Items</h2>
    <% if members.present? %>
      <span class="dc-panel-count"><%= ids.total_count %></span>
    <% end %>
  </div>

  <% if members.present? %>
    <ul class="dc-item-list list-unstyled">
      <% members.each do |member| %>
        <li class="dc-item-row"><%= member.first_title %></li>
      <% end %>
    </ul>
  <% end %>
</section>
