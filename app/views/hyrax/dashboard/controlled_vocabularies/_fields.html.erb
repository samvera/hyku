<% required = local_assigns.fetch(:required, false) %>
<% if f.object.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <ul class="mb-0">
      <% f.object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="form-group">
  <%= f.label :label, t('hyku.admin.controlled_vocabulary.name'), class: 'control-label' %>
  <%= f.text_field :label, class: 'form-control', required: required %>
</div>

<div class="form-group">
  <%= f.label :description, t('hyku.admin.controlled_vocabulary.description'), class: 'control-label' %>
  <%= f.text_area :description, class: 'form-control', rows: 3 %>
  <small class="form-text text-muted">
    <%= t('hyku.admin.controlled_vocabulary.description_help') %>
  </small>
</div>
