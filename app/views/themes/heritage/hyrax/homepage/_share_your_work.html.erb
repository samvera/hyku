<section class="hrt-cta" aria-labelledby="hrt-cta-heading">
  <div class="hrt-cta-copy">
    <h2 class="hrt-cta-heading" id="hrt-cta-heading"><%= t('heritage.homepage.cta.heading') %></h2>
    <p class="hrt-cta-sub"><%= t('heritage.homepage.cta.sub') %></p>
  </div>
  <div class="hrt-cta-actions">
    <%= link_to t(:'hyrax.pages.tabs.terms_page'), hyrax.terms_path, class: 'hrt-cta-terms' %>
    <% href, data = theme_deposit_target %>
    <%= link_to t('heritage.homepage.cta.button'), href, data:, class: 'hrt-cta-button' %>
  </div>
</section>
