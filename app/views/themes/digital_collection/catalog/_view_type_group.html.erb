<%# OVERRIDE Blacklight 7.43.0: icons hidden from screen readers, so each view button reads its visible caption once; Gallery reads "Grid", matching the homepage toggle; links stay on this site whatever the query string holds %>
<% views = document_index_view_controls.keys.filter_map { |key| (view = blacklight_config.view[key]) && view.if != false ? [key, view] : nil } %>
<% if show_sort_and_per_page? && views.many? %>
  <div class="view-type dc-view-toggle">
    <span class="sr-only visually-hidden"><%= t('blacklight.search.view_title') %></span>
    <div class="view-type-group dc-view-toggle-group">
      <% views.each do |key, view| %>
        <% selected = key.to_s == document_index_view_type.to_s %>
        <%= link_to url_for(search_state.to_h.merge(view: key, only_path: true)), class: "dc-control view-type-#{key.to_s.parameterize}#{' active' if selected}", 'aria-current': (selected ? 'true' : nil) do %>
          <span class="dc-view-toggle-icon" aria-hidden="true">
            <% if view.icon.is_a?(Class) %>
              <%= render view.icon.new %>
            <% elsif view.icon.is_a?(ViewComponent::Base) %>
              <%= render view.icon %>
            <% else %>
              <%= blacklight_icon(view.icon || key, label: false) %>
            <% end %>
          </span>
          <span class="caption"><%= key.to_s == 'gallery' ? t('digital_collection.homepage.browse.grid') : Deprecation.silence(Blacklight::ConfigurationHelperBehavior) { view_label(key) } %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
