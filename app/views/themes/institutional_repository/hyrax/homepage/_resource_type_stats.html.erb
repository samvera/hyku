<div class="ir-stats">
  <% tiles.each do |tile| %>
    <div class="col">
      <div class="text-center">
        <%= link_to tile[:path], style: "color: inherit;" do %>
          <i class="fa-pals fa fa-2x <%= tile[:icon] %>" aria-hidden="true"></i>
          <h5><%= tile[:label] %></h5>
          <p><%= tile[:count] %></p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
