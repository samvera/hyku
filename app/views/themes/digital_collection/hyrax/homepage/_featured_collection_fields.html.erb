<% branding = CollectionBrandingInfo.where(collection_id: featured.id, role: "banner").first %>
<% banner = branding ? "/" + branding.local_path.split("/")[-4..-1].join("/") : nil %>

<%= render layout: 'hyrax/homepage/dc_featured_row',
           locals: { url: hyrax.collection_path(featured.id), thumb_class: 'dc-featured-thumb-wide',
                     title: Array(featured.title).first.presence || featured.try(:title_or_label) } do %>
  <img src="<%= banner || banner_image %>" alt="">
<% end %>
