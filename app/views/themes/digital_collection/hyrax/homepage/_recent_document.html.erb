<%# OVERRIDE Hyku 7.1.0: a thumbnail and title row instead of depositor and keywords %>
<% url = generate_work_url(recent_document, request) %>

<div class="dc-recent-row">
  <%= link_to url, class: token_list('dc-recent-thumb', dc_thumb_placeholder_class(recent_document)), tabindex: -1, aria: { hidden: true },
              data: { turbolinks: block_valkyrie_redirect? } do %>
    <%= render_thumbnail_tag(recent_document, { alt: '' }, { suppress_link: true }) %>
  <% end %>

  <h3 class="dc-recent-title">
    <%= link_to recent_document.title_or_label, url,
                data: { turbolinks: block_valkyrie_redirect? } %>
  </h3>
</div>
