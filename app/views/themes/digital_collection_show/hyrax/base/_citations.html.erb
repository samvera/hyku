<%# OVERRIDE Hyrax 5.3.0: citation panel with a style picker, copy button and EndNote link %>
<% citations = all_authors(presenter).any? ? theme_citations(presenter) : {} %>
<%= render layout: 'hyrax/base/dc_panel',
           locals: { modifier: 'dc-cite', label_id: 'dc-cite-label', label: t('hyrax.base.citations.header') } do %>
  <div class="dc-panel-body" data-citation>
    <% if citations.any? %>
      <select class="dc-cite-picker" data-citation-picker
              aria-label="<%= t('hyrax.base.citations.style') %>">
        <% citations.each_key do |style| %>
          <option value="<%= style %>"><%= t("hyrax.citations.work.#{style}") %></option>
        <% end %>
      </select>

      <% citations.each_with_index do |(style, text), index| %>
        <blockquote class="dc-cite-text" data-citation-text="<%= style %>"
                    <%= 'hidden' unless index.zero? %>><%= text %></blockquote>
      <% end %>

      <div class="dc-cite-actions">
        <button type="button" class="dc-cite-copy" data-citation-copy>
          <%= t('hyrax.base.citations.copy') %>
        </button>
        <span class="dc-cite-copied" data-citation-copied hidden aria-live="polite">
          <%= t('hyrax.base.citations.copied') %>
        </span>
      </div>
    <% end %>

    <%= link_to t('hyrax.base.citations.endnote'),
                polymorphic_path([main_app, presenter], format: 'endnote'),
                class: 'dc-cite-export' %>
  </div>
<% end %>
